# Optional: GitHub personal access token to raise the Releases API rate
# limit from 60 req/h (anonymous) to 5000 req/h. NOT required for Phase 1
# — the 5-minute server cache keeps us well under the anonymous limit.
# If set, the /api/updates/latest(.yml) endpoints will use it. Read-only,
# public_repo scope is sufficient.
GITHUB_TOKEN=

# Which GitHub repo hosts Nexus release artifacts. Format: owner/repo.
# This is the PUBLIC release host (jltps/nexus-releases), NOT the private
# source repo (jltps/MeetingTranscriber). Documented in docs/API_CONTRACT.md.
NEXUS_RELEASES_REPO=jltps/nexus-releases

# Optional: Anthropic API key used by the `translate:releases` script
# (scripts/translate-releases.ts) to translate live release notes to English
# into the committed cache (src/lib/release-translations.json). Supplied ONLY
# as a GitHub Actions secret for the translate-releases workflow — never set
# locally and never committed. Without it the script no-ops and exits 0, so
# local build/typecheck never need a key.
ANTHROPIC_API_KEY=

# Optional: override the Claude model used by `translate:releases`.
# Defaults to claude-haiku-4-5-20251001 when unset.
TRANSLATE_MODEL=
