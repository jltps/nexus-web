# Optional: GitHub personal access token to raise the Releases API rate
# limit from 60 req/h (anonymous) to 5000 req/h. NOT required for Phase 1
# — the 5-minute server cache keeps us well under the anonymous limit.
# If set, the /api/updates/latest(.yml) endpoints will use it. Read-only,
# public_repo scope is sufficient.
GITHUB_TOKEN=

# Which GitHub repo hosts Nexus release artifacts. Format: owner/repo.
# Documented in docs/API_CONTRACT.md.
NEXUS_RELEASES_REPO=jlts2010/nexus-releases
